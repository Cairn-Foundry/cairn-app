        },
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "text": "After retrying a failed job the badge " },
            { "type": "text", "text": "stays red", "marks": [{ "type": "strong" }] },
            { "type": "text", "text": " until a " },
            { "type": "text", "text": "reload", "marks": [{ "type": "em" }] },
            { "type": "text", "text": ". See " },
            {
              "type": "text",
              "text": "the store",
              "marks": [{ "type": "link", "attrs": { "href": "https://gitlab.com/cairn/cairn/-/blob/main/src/lib/stores/pipelines.ts" } }]
            },
            { "type": "text", "text": "." }
          ]
        },
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                { "type": "paragraph", "content": [{ "type": "text", "text": "Open the CI/CD tab" }] }
              ]
            },
            {
              "type": "listItem",
              "content": [
                { "type": "paragraph", "content": [{ "type": "text", "text": "Retry the failed job" }] },
                {
                  "type": "orderedList",
                  "attrs": { "order": 1 },
                  "content": [
                    {
                      "type": "listItem",
                      "content": [
                        { "type": "paragraph", "content": [{ "type": "text", "text": "wait for it to finish" }] }
                      ]
                    },
                    {
                      "type": "listItem",
                      "content": [
                        { "type": "paragraph", "content": [{ "type": "text", "text": "the badge does not move" }] }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "codeBlock",
          "attrs": { "language": "typescript" },
          "content": [{ "type": "text", "text": "pipelines.refresh(id);\nbadge.update();" }]
        },
