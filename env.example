# Copy to .env to use. Read by `bun run tauri:dev`, which exports it to the
# processes tauri spawns - a bare `bun run` keeps it to bun's own runtime.

# Which data directory the app owns.
#   unset / anything else  ~/.cairn        the installed app
#   beta                   ~/.cairn-beta
#   dev                    ~/.cairn-dev
APP_ENVIRONMENT=dev