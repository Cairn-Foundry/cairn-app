{
  "name": "cairn",
  "version": "1.2.0",
  "description": "Cairn Foundry - a desktop workspace for developing with an AI coding agent",
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "preinstall": "bun scripts/check-bun-version.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "biome check --write src",
    "lint:ci": "biome ci src",
    "test": "vitest run --passWithNoTests",
    "test:rust": "cd src-tauri && cargo test",
    "test:all": "bun run test && bun run test:rust",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "tauri": "tauri",
    "tauri:dev": "bun --env-file=.env run tauri dev",
    "tauri:linux": "env -u LD_LIBRARY_PATH -u GTK_PATH -u GIO_MODULE_DIR -u GDK_PIXBUF_MODULE_FILE NO_STRIP=1 tauri"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-minimap": "^0.5.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "codemirror-lang-svelte": "^2.1.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@vitest/coverage-istanbul": "^5.1.0",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "resolutions": {
    "dompurify": "^3.4.17",
    "undici": "^7.30.1",
    "katex": "^0.19.0",
    "source-map-js": "^1.2.2",
    "@codemirror/view": "6.43.15",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@lezer/highlight": "1.2.5"
  },
  "patchedDependencies": {
    "@replit/codemirror-minimap@0.5.2": "patches/@replit%2Fcodemirror-minimap@0.5.2.patch"
  }
}
